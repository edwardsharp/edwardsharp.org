{
  "name": "edwardsharp.org",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "import:social": "node src/utilz/import-social.ts",
    "import:images": "node src/utilz/import-images.ts",
    "export:notes": "python3 src/utilz/export-notes.py",
    "import:photos": "src/utilz/.venv/bin/python src/utilz/import-photos.py",
    "convert:webp": "ruby src/utilz/convert-webp.rb",
    "update:dates": "ruby src/utilz/update-post-dates.rb",
    "build": "npm run typecheck && node src/ts/esbuild.config.ts",
    "typecheck": "tsc --project src/tsconfig.json",
    "test": "node --test src/ts/tests/*.test.ts src/utilz/tests/*.test.ts && python3 -m unittest discover -s src/utilz/tests -p '*_test.py'",
    "format": "prettier . --write --ignore-unknown --ignore-path .gitignore --ignore-path src/.prettierignore",
    "format:check": "prettier . --check --ignore-unknown --ignore-path .gitignore --ignore-path src/.prettierignore"
  },
  "prettier": "./src/prettier.config.mjs",
  "dependencies": {
    "@tanstack/virtual-core": "3.19.11",
    "lunr": "2.3.9"
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "1.11.4",
    "@types/lunr": "^2.3.7",
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "linkedom": "0.18.15",
    "prettier": "3.10.1",
    "typescript": "^7.0.2"
  }
}
