---
layout: null
permalink: /feed.json
---
[
{% for post in site.posts %}
  {% assign title = post.preview_title | default: post.title %}
  {% if title == 'no title' %}
    {% capture title %}{{ post.kind | default: 'post' }} / {{ post.date | date: '%Y-%m-%d' }}{% endcapture %}
  {% endif %}
  { "id": {{ post.url | jsonify }}, "url": {{ post.url | relative_url | jsonify }}, "title": {{ title | jsonify }},
  "kind": {{ post.kind | default: 'entry' | jsonify }}, "date": {{ post.date | date_to_xmlschema | jsonify }}, "label":
  {{ post.date | date: '%Y-%m-%d' | jsonify }}, "excerpt":
  {{ post.content | strip_html | normalize_whitespace | truncate: 180 | jsonify }}, "image":
  {% if post.preview_image %}{{ post.preview_image | relative_url | jsonify }}{% else %}null{% endif %}, "alt":
  {{ post.preview_alt | default: '' | jsonify }}, "tags": [
  {%- for tag in post.tags -%}
    {{- tag | jsonify -}}
    {%- unless forloop.last %},{% endunless -%}
  {%- endfor -%}
  ] }
  {%- unless forloop.last %},{% endunless %}
{% endfor %}
]
