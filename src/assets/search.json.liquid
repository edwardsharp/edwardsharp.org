---
layout: null
permalink: /search.json
---
{% assign page_collection = site.collections | where: 'label', 'pages' | first %}
{% assign archive_pages = page_collection.docs | where_exp: 'entry', 'entry.searchable != false' | sort: 'title' %}
{% assign entries = site.posts | concat: archive_pages %}
[
{% for entry in entries %}
  {% assign title = entry.preview_title | default: entry.title %}
  {% if title == 'no title' %}
    {% capture title %}{{ entry.kind | default: 'post' }} / {{ entry.date | date: '%Y-%m-%d' }}{% endcapture %}
  {% endif %}
  { "url": {{ entry.url | relative_url | jsonify }}, "title": {{ title | jsonify }}, "text":
  {{ entry.content | strip_html | normalize_whitespace | jsonify }}, "tags": [
  {%- for tag in entry.tags -%}
    {{- tag | jsonify -}}
    {%- unless forloop.last %},{% endunless -%}
  {%- endfor -%}
  ], "kind": {% if entry.collection == 'posts' %}{{ entry.kind | default: 'entry' | jsonify }}{% else %}null{% endif %}, "date":
  {% if entry.collection == 'posts' %}{{ entry.date | date: '%Y-%m-%d' | jsonify }}{% else %}null{% endif %} }
  {%- unless forloop.last %},{% endunless %}
{% endfor %}
]
