---
layout: null
permalink: /search.json
---
{% assign page_collection = site.collections | where: 'label', 'pages' | first %}
{% assign archive_pages = page_collection.docs | where_exp: 'entry', 'entry.searchable != false' | sort: 'title' %}
{% assign entries = site.posts | concat: archive_pages %}
[
{% for entry in entries %}
  {% assign title = entry.preview_title | default: '' | strip %}
  {% if title == '' %}
    {% assign title = entry.title | default: '' | strip %}
  {% endif %}
  {% assign normalized_title = title | downcase %}
  {% if title == '' or normalized_title == 'no title' or normalized_title == 'untitled' %}
    {% if entry.collection == 'posts' %}
      {% capture title %}{{ entry.kind | default: 'post' }} / {{ entry.date | date: '%Y-%m-%d' }}{% endcapture %}
    {% else %}
      {% assign title = entry.url %}
    {% endif %}
  {% endif %}
  { "url": {{ entry.url | relative_url | jsonify }}, "title": {{ title | jsonify }}, "text":
  {{ entry.description | append: ' ' | append: entry.content | strip_html | normalize_whitespace | jsonify }}, "tags": [
  {%- for tag in entry.tags -%}
    {{- tag | jsonify -}}
    {%- unless forloop.last %},{% endunless -%}
  {%- endfor -%}
  ],
  {% assign locations = entry.locations | map: 'name' | push: entry.location_name | compact | uniq %}
  "locations": {{ locations | jsonify }}, "kind":
  {% if entry.collection == 'posts' %}{{ entry.kind | default: 'entry' | jsonify }}{% else %}null{% endif %}, "date":
  {% if entry.collection == 'posts' %}{{ entry.date | date: '%Y-%m-%d' | jsonify }}{% else %}null{% endif %} }
  {%- unless forloop.last %},{% endunless %}
{% endfor %}
]
