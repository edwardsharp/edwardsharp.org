---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ '/' | absolute_url | xml_escape }}</link>
    <description>{{ site.description | xml_escape }}</description>
    <language>{{ site.lang | xml_escape }}</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <atom:link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/rss+xml" />
    {% for post in site.posts %}
      {% assign title = post.preview_title | default: post.title %}
      {% if title == 'no title' %}
        {% capture title %}{{ post.kind | default: 'post' }} / {{ post.date | date: '%Y-%m-%d' }}{% endcapture %}
      {% endif %}
      <item>
        <title>{{ title | xml_escape }}</title>
        <link>{{ post.url | absolute_url | xml_escape }}</link>
        <guid isPermaLink="true">{{ post.url | absolute_url | xml_escape }}</guid>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        <description>{{ post.excerpt | strip_html | normalize_whitespace | truncate: 300 | xml_escape }}</description>
        {% for tag in post.tags %}
          <category>{{ tag | xml_escape }}</category>
        {% endfor %}
      </item>
    {% endfor %}
  </channel>
</rss>
